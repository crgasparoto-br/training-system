generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                                                                String                                 @id @default(cuid())
  email                                                                                             String                                 @unique
  passwordHash                                                                                      String
  type                                                                                              UserType
  createdAt                                                                                         DateTime                               @default(now())
  updatedAt                                                                                         DateTime                               @updatedAt
  isActive                                                                                          Boolean                                @default(true)
  lastLoginAt                                                                                       DateTime?
  AdipometryAssessment_AdipometryAssessment_skinfoldCapacityWarningConfirmedByUserIdToUser          AdipometryAssessment[]                 @relation("AdipometryAssessment_skinfoldCapacityWarningConfirmedByUserIdToUser")
  AdipometryAssessment_AdipometryAssessment_correctionAuthorUserIdToUser                            AdipometryAssessment[]                 @relation("AdipometryAssessment_correctionAuthorUserIdToUser")
  AdipometryAssessment_AdipometryAssessment_correctionCancelledByUserIdToUser                       AdipometryAssessment[]                 @relation("AdipometryAssessment_correctionCancelledByUserIdToUser")
  AdipometryAssessment_AdipometryAssessment_protocolChangeConfirmedByUserIdToUser                   AdipometryAssessment[]                 @relation("AdipometryAssessment_protocolChangeConfirmedByUserIdToUser")
  AdipometryAssessment_AdipometryAssessment_protocolSexConfirmedByUserIdToUser                      AdipometryAssessment[]                 @relation("AdipometryAssessment_protocolSexConfirmedByUserIdToUser")
  AdipometryAssessment_AdipometryAssessment_voidedByUserIdToUser                                    AdipometryAssessment[]                 @relation("AdipometryAssessment_voidedByUserIdToUser")
  AdipometryAuditEvent                                                                              AdipometryAuditEvent[]
  AdipometryClinicalResponsibility_AdipometryClinicalResponsibility_designatedByUserIdToUser        AdipometryClinicalResponsibility[]     @relation("AdipometryClinicalResponsibility_designatedByUserIdToUser")
  AdipometryClinicalResponsibility_AdipometryClinicalResponsibility_endedByUserIdToUser             AdipometryClinicalResponsibility[]     @relation("AdipometryClinicalResponsibility_endedByUserIdToUser")
  AdipometryProtocol                                                                                AdipometryProtocol[]
  AdipometryProtocolApproval_AdipometryProtocolApproval_revokedByUserIdToUser                       AdipometryProtocolApproval[]           @relation("AdipometryProtocolApproval_revokedByUserIdToUser")
  AdipometryProtocolApproval_AdipometryProtocolApproval_approvedByUserIdToUser                      AdipometryProtocolApproval[]           @relation("AdipometryProtocolApproval_approvedByUserIdToUser")
  alunos                                                                                            Aluno[]
  notifications                                                                                     Notification[]
  notificationPreferences                                                                           NotificationPreferences?
  PreRegistrationGuardianAuthorization_PreRegistrationGuardianAuthorization_guardianUserIdToUser    PreRegistrationGuardianAuthorization[] @relation("PreRegistrationGuardianAuthorization_guardianUserIdToUser")
  PreRegistrationGuardianAuthorization_PreRegistrationGuardianAuthorization_revokedByUserIdToUser   PreRegistrationGuardianAuthorization[] @relation("PreRegistrationGuardianAuthorization_revokedByUserIdToUser")
  PreRegistrationGuardianAuthorization_PreRegistrationGuardianAuthorization_validatedByUserIdToUser PreRegistrationGuardianAuthorization[] @relation("PreRegistrationGuardianAuthorization_validatedByUserIdToUser")
  ProfessionalActorMembership                                                                       ProfessionalActorMembership?
  professor                                                                                         Professor?
  profile                                                                                           Profile?
  onboardingParqConsentsAccepted                                                                    StudentOnboardingProcess[]             @relation("StudentOnboardingParqConsentAcceptedBy")
  onboardingParqConsentsRevoked                                                                     StudentOnboardingProcess[]             @relation("StudentOnboardingParqConsentRevokedBy")
  parqDraftConsents                                                                                 StudentParqDraft[]                     @relation("StudentParqDraftConsent")
  profileReviewsApproved                                                                            StudentProfileReview[]                 @relation("StudentProfileReviewApprovedBy")
  profileReviewsRejected                                                                            StudentProfileReview[]                 @relation("StudentProfileReviewRejectedBy")
  profileReviewsRequested                                                                           StudentProfileReview[]                 @relation("StudentProfileReviewRequestedBy")

  @@index([email])
}

model Profile {
  id                                   String         @id @default(cuid())
  userId                               String         @unique
  name                                 String
  avatar                               String?
  phone                                String?
  createdAt                            DateTime       @default(now())
  updatedAt                            DateTime       @updatedAt
  birthDate                            DateTime?
  gender                               Gender?
  cpf                                  String?
  rg                                   String?
  maritalStatus                        MaritalStatus?
  addressStreet                        String?
  addressNumber                        String?
  addressComplement                    String?
  addressZipCode                       String?
  instagramHandle                      String?
  cref                                 String?
  professionalSummary                  String?
  lattesUrl                            String?
  companyDocument                      String?
  bankName                             String?
  bankBranch                           String?
  bankAccount                          String?
  pixKey                               String?
  legalFinancialProvidedAt             DateTime?
  legalFinancialProvidedByProfessorId  String?
  legalFinancialValidatedAt            DateTime?
  legalFinancialValidatedByProfessorId String?
  addressNeighborhood                  String?
  addressCity                          String?
  addressState                         String?
  bankCode                             String?
  legalFinancialProvidedByProfessor    Professor?     @relation("ProfileLegalFinancialProvidedBy", fields: [legalFinancialProvidedByProfessorId], references: [id])
  legalFinancialValidatedByProfessor   Professor?     @relation("ProfileLegalFinancialValidatedBy", fields: [legalFinancialValidatedByProfessorId], references: [id])
  user                                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([legalFinancialProvidedByProfessorId])
  @@index([legalFinancialValidatedByProfessorId])
  @@index([bankCode])
  @@index([cpf])
}

model Bank {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  ispb        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([description])
}

model CompanyContract {
  id                                   String                                 @id @default(cuid())
  type                                 ContractType
  document                             String                                 @unique
  name                                 String?
  createdAt                            DateTime                               @default(now())
  updatedAt                            DateTime                               @updatedAt
  cref                                 String?
  addressStreet                        String?
  addressNumber                        String?
  addressNeighborhood                  String?
  addressCity                          String?
  addressState                         String?
  addressComplement                    String?
  addressZipCode                       String?
  logoUrl                              String?
  tradeName                            String?
  AdipometryAssessment                 AdipometryAssessment[]
  AdipometryAuditEvent                 AdipometryAuditEvent[]
  AdipometryClinicalResponsibility     AdipometryClinicalResponsibility[]
  AdipometryProtocolApproval           AdipometryProtocolApproval[]
  AdipometrySequence                   AdipometrySequence[]
  agendaBookings                       AgendaBooking[]
  Aluno                                Aluno[]
  anthropometryAssessments             AnthropometryAssessment[]
  anthropometrySegments                AnthropometrySegment[]
  assessmentTypes                      AssessmentType[]
  CapacityPlanningCycle                CapacityPlanningCycle[]
  CapacityPrescription                 CapacityPrescription[]
  CapacityPrescriptionParameterSet     CapacityPrescriptionParameterSet[]
  CapacityPrescriptionVersion          CapacityPrescriptionVersion[]
  CapacityTechnicalCatalogItem         CapacityTechnicalCatalogItem[]
  collaboratorFunctions                CollaboratorFunctionOption[]
  ConsolidatedPrescription             ConsolidatedPrescription[]
  ConsolidatedPrescriptionVersion      ConsolidatedPrescriptionVersion[]
  cloneLogsAsSource                    ContractDataCloneLog[]                 @relation("ContractCloneSource")
  cloneLogsAsTarget                    ContractDataCloneLog[]                 @relation("ContractCloneTarget")
  contractTemplates                    ContractTemplate[]
  exerciseLibrary                      ExerciseLibrary[]
  generatedContracts                   Contract[]
  hourlyRateLevels                     HourlyRateLevel[]
  PreRegistrationGuardianAuthorization PreRegistrationGuardianAuthorization[]
  PreRegistrationInvite                PreRegistrationInvite[]
  ProfessionalActorMembership          ProfessionalActorMembership[]
  professores                          Professor[]
  professorManualItems                 ProfessorManualItem[]
  profileReviewPolicies                ProfileReviewPolicy[]
  prontuarioDiscomfortSnapshots        ProntuarioDiscomfortSnapshot[]
  ProntuarioGoalCapacityClassification ProntuarioGoalCapacityClassification[]
  prontuarioRecords                    ProntuarioRecord[]
  serviceCommercialOptions             ServiceCommercialOption[]
  services                             ServiceOption[]
  servicePlanComponents                ServicePlanComponent[]
  servicePresentationItems             ServicePresentationItem[]
  studentAssessmentRecords             StudentAssessmentRecord[]
  studentExternalAccounts              StudentExternalAccount[]
  studentExternalActivities            StudentExternalActivity[]
  studentFinancialProfiles             StudentFinancialProfile[]
  studentHealthIntakes                 StudentHealthIntake[]
  StudentLifecycleEvent                StudentLifecycleEvent[]
  studentOnboardingProcesses           StudentOnboardingProcess[]
  studentParqDrafts                    StudentParqDraft[]
  studentParqLegacyRecords             StudentParqLegacyRecord[]
  studentParqProfessionalReviews       StudentParqProfessionalReview[]
  studentParqSubmissions               StudentParqSubmission[]
  studentProfiles                      StudentProfile[]
  subjectiveScaleItems                 SubjectiveScaleItem[]
  trainingParameters                   TrainingParameter[]
  trainingSpaces                       TrainingSpace[]

  @@index([type])
  @@map("Contract")
}

model ContractTemplate {
  id            String                        @id @default(cuid())
  contractId    String
  name          String
  description   String?
  serviceId     String?
  version       Int                           @default(1)
  status        ContractTemplateStatus        @default(DRAFT)
  headerHtml    String                        @default("")
  footerHtml    String                        @default("")
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt
  applicability ContractTemplateApplicability @default(STUDENT)
  contract      CompanyContract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service       ServiceOption?                @relation(fields: [serviceId], references: [id])
  clauses       ContractTemplateClause[]
  contracts     Contract[]

  @@index([contractId, status])
  @@index([serviceId])
}

model ContractTemplateClause {
  id         String           @id @default(cuid())
  templateId String
  order      Int
  title      String
  bodyHtml   String
  required   Boolean          @default(true)
  editable   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  template   ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
  @@index([templateId])
}

model Contract {
  id                   String                @id @default(cuid())
  companyContractId    String
  templateId           String
  templateVersion      Int
  alunoId              String?
  responsavelName      String?
  responsavelCpf       String?
  responsavelEmail     String?
  serviceId            String?
  professorId          String?
  status               ContractStatus        @default(DRAFT)
  title                String
  renderedHtml         String
  dataSnapshot         Json
  pdfPath              String?
  publicTokenHash      String?               @unique
  publicTokenExpiresAt DateTime?
  externalProvider     String?
  externalEnvelopeId   String?
  documentHash         String?
  signedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  partyType            ContractPartyType     @default(STUDENT)
  collaboratorId       String?
  origin               ContractLinkOrigin    @default(ELECTRONIC)
  collaboratorContract CollaboratorContract?
  auditLogs            ContractAuditLog[]
  signatures           ContractSignature[]
  aluno                Aluno?                @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  collaborator         Professor?            @relation("ContractCollaborator", fields: [collaboratorId], references: [id], onDelete: Restrict)
  companyContract      CompanyContract       @relation(fields: [companyContractId], references: [id], onDelete: Cascade)
  professor            Professor?            @relation("ContractResponsibleProfessor", fields: [professorId], references: [id])
  service              ServiceOption?        @relation(fields: [serviceId], references: [id])
  template             ContractTemplate      @relation(fields: [templateId], references: [id])
  studentContracts     StudentContract?

  @@index([companyContractId, status])
  @@index([alunoId])
  @@index([collaboratorId])
  @@index([partyType])
  @@index([templateId])
  @@index([serviceId])
  @@index([professorId])
  @@map("GeneratedContract")
}

model CollaboratorContract {
  id                  String                     @id @default(cuid())
  collaboratorId      String
  contractId          String?                    @unique
  status              CollaboratorContractStatus @default(draft)
  origin              ContractLinkOrigin         @default(ELECTRONIC)
  startDate           DateTime?
  endDate             DateTime?
  signedAt            DateTime?
  canceledAt          DateTime?
  cancellationReason  String?
  notes               String?
  legacyDocumentUrl   String?
  legacySourceKey     String?                    @unique
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  collaborator        Professor                  @relation("CollaboratorContracts", fields: [collaboratorId], references: [id])
  contract            Contract?                  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  currentForProfessor Professor[]                @relation("CurrentCollaboratorContract")

  @@index([collaboratorId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model ContractSignature {
  id           String   @id @default(cuid())
  contractId   String
  signerName   String
  signerCpf    String
  signerEmail  String?
  ipAddress    String?
  userAgent    String?
  acceptedAt   DateTime @default(now())
  documentHash String
  method       String   @default("INTERNAL_ELECTRONIC_ACCEPTANCE")
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([signerCpf])
}

model ContractAuditLog {
  id          String              @id @default(cuid())
  contractId  String
  actorUserId String?
  action      ContractAuditAction
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime            @default(now())
  contract    Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@index([actorUserId])
}

model CollaboratorFunctionOption {
  id                          String                        @id @default(cuid())
  contractId                  String
  name                        String
  code                        String
  isActive                    Boolean                       @default(true)
  isSystem                    Boolean                       @default(false)
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @default(now()) @updatedAt
  accessPermissions           AccessPermission[]
  contract                    CompanyContract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  ProfessionalActorMembership ProfessionalActorMembership[]
  professores                 Professor[]

  @@unique([contractId, code])
  @@unique([id, contractId])
  @@index([contractId])
}

model AccessPermission {
  id                     String                     @id @default(cuid())
  collaboratorFunctionId String
  screenKey              String
  blockKey               String                     @default("")
  canView                Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @default(now()) @updatedAt
  dataScope              String?
  collaboratorFunction   CollaboratorFunctionOption @relation(fields: [collaboratorFunctionId], references: [id], onDelete: Cascade)

  @@unique([collaboratorFunctionId, screenKey, blockKey])
  @@index([collaboratorFunctionId])
  @@index([screenKey])
}

model Professor {
  id                                                                                                String                                 @id(map: "Educator_pkey") @default(cuid())
  userId                                                                                            String                                 @unique(map: "Educator_userId_key")
  createdAt                                                                                         DateTime                               @default(now())
  updatedAt                                                                                         DateTime                               @updatedAt
  contractId                                                                                        String
  role                                                                                              ProfessorRole                          @default(professor)
  collaboratorFunctionId                                                                            String
  responsibleManagerId                                                                              String?
  admissionDate                                                                                     DateTime?
  currentStatus                                                                                     String?
  operationalRoleIds                                                                                String[]                               @default([])
  hourlyRates                                                                                       Json?
  hasSignedContract                                                                                 Boolean                                @default(false)
  signedContractDocumentUrl                                                                         String?
  dismissalDate                                                                                     DateTime?
  currentCollaboratorContractId                                                                     String?
  AdipometryAssessment                                                                              AdipometryAssessment[]
  AdipometryClinicalResponsibility                                                                  AdipometryClinicalResponsibility[]
  AdipometryProtocolApproval_AdipometryProtocolApproval_approvedByProfessorIdToProfessor            AdipometryProtocolApproval[]           @relation("AdipometryProtocolApproval_approvedByProfessorIdToProfessor")
  AdipometryProtocolApproval_AdipometryProtocolApproval_revokedByProfessorId_contractIdToProfessor  AdipometryProtocolApproval[]           @relation("AdipometryProtocolApproval_revokedByProfessorId_contractIdToProfessor")
  agendaBookings                                                                                    AgendaBooking[]
  Aluno_Aluno_createdByProfessorIdToProfessor                                                       Aluno[]                                @relation("Aluno_createdByProfessorIdToProfessor")
  Aluno_Aluno_discardedByProfessorIdToProfessor                                                     Aluno[]                                @relation("Aluno_discardedByProfessorIdToProfessor")
  alunos                                                                                            Aluno[]
  anthropometryAssessments                                                                          AnthropometryAssessment[]
  Assessment                                                                                        Assessment[]
  assessmentAuditLogs                                                                               AssessmentAuditLog[]
  CapacityPlanningCycle                                                                             CapacityPlanningCycle[]
  CapacityPrescription_CapacityPrescription_createdByProfessorIdToProfessor                         CapacityPrescription[]                 @relation("CapacityPrescription_createdByProfessorIdToProfessor")
  CapacityPrescription_CapacityPrescription_updatedByProfessorIdToProfessor                         CapacityPrescription[]                 @relation("CapacityPrescription_updatedByProfessorIdToProfessor")
  CapacityPrescriptionParameterSet                                                                  CapacityPrescriptionParameterSet[]
  CapacityPrescriptionVersion                                                                       CapacityPrescriptionVersion[]
  CapacityTechnicalCatalogItem                                                                      CapacityTechnicalCatalogItem[]
  collaboratorContracts                                                                             CollaboratorContract[]                 @relation("CollaboratorContracts")
  ConsolidatedPrescription_ConsolidatedPrescription_createdByProfessorIdToProfessor                 ConsolidatedPrescription[]             @relation("ConsolidatedPrescription_createdByProfessorIdToProfessor")
  ConsolidatedPrescription_ConsolidatedPrescription_updatedByProfessorIdToProfessor                 ConsolidatedPrescription[]             @relation("ConsolidatedPrescription_updatedByProfessorIdToProfessor")
  ConsolidatedPrescriptionDataRef                                                                   ConsolidatedPrescriptionDataRef[]
  ConsolidatedPrescriptionVersion_ConsolidatedPrescriptionVersion_approvedByProfessorIdToProfessor  ConsolidatedPrescriptionVersion[]      @relation("ConsolidatedPrescriptionVersion_approvedByProfessorIdToProfessor")
  ConsolidatedPrescriptionVersion_ConsolidatedPrescriptionVersion_blockedByProfessorIdToProfessor   ConsolidatedPrescriptionVersion[]      @relation("ConsolidatedPrescriptionVersion_blockedByProfessorIdToProfessor")
  ConsolidatedPrescriptionVersion_ConsolidatedPrescriptionVersion_createdByProfessorIdToProfessor   ConsolidatedPrescriptionVersion[]      @relation("ConsolidatedPrescriptionVersion_createdByProfessorIdToProfessor")
  ConsolidatedPrescriptionVersion_ConsolidatedPrescriptionVersion_responsibleProfessorIdToProfessor ConsolidatedPrescriptionVersion[]      @relation("ConsolidatedPrescriptionVersion_responsibleProfessorIdToProfessor")
  ConsolidatedPrescriptionVersion_ConsolidatedPrescriptionVersion_reviewedByProfessorIdToProfessor  ConsolidatedPrescriptionVersion[]      @relation("ConsolidatedPrescriptionVersion_reviewedByProfessorIdToProfessor")
  cloneLogs                                                                                         ContractDataCloneLog[]
  fixedSlots                                                                                        FixedScheduleSlot[]
  generatedCollaboratorContracts                                                                    Contract[]                             @relation("ContractCollaborator")
  generatedContracts                                                                                Contract[]                             @relation("ContractResponsibleProfessor")
  contract                                                                                          CompanyContract                        @relation(fields: [contractId], references: [id], onDelete: Cascade, map: "Educator_contractId_fkey")
  user                                                                                              User                                   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Educator_userId_fkey")
  collaboratorFunction                                                                              CollaboratorFunctionOption             @relation(fields: [collaboratorFunctionId], references: [id])
  currentCollaboratorContract                                                                       CollaboratorContract?                  @relation("CurrentCollaboratorContract", fields: [currentCollaboratorContractId], references: [id])
  responsibleManager                                                                                Professor?                             @relation("ProfessorResponsibleManager", fields: [responsibleManagerId], references: [id])
  managedCollaborators                                                                              Professor[]                            @relation("ProfessorResponsibleManager")
  availabilities                                                                                    ProfessorAvailability[]
  providedLegalFinancialProfiles                                                                    Profile[]                              @relation("ProfileLegalFinancialProvidedBy")
  validatedLegalFinancialProfiles                                                                   Profile[]                              @relation("ProfileLegalFinancialValidatedBy")
  ProntuarioGoalCapacityClassification                                                              ProntuarioGoalCapacityClassification[]
  prontuarioRecords                                                                                 ProntuarioRecord[]
  parqReviewsCompleted                                                                              StudentParqProfessionalReview[]        @relation("StudentParqReviewedBy")
  subscription                                                                                      Subscription?
  library                                                                                           TrainingLibrary[]
  plans                                                                                             TrainingPlan[]

  @@unique([id, contractId])
  @@index([collaboratorFunctionId])
  @@index([responsibleManagerId])
  @@index([currentCollaboratorContractId])
  @@index([contractId], map: "Educator_contractId_idx")
}

model ContractDataCloneLog {
  id                     String          @id @default(cuid())
  sourceContractId       String
  targetContractId       String
  professorId            String?
  parametersCreated      Int
  parametersSkipped      Int
  exercisesCreated       Int
  exercisesSkipped       Int
  createdAt              DateTime        @default(now())
  assessmentTypesCreated Int             @default(0)
  assessmentTypesSkipped Int             @default(0)
  professor              Professor?      @relation(fields: [professorId], references: [id], map: "ContractDataCloneLog_educatorId_fkey")
  sourceContract         CompanyContract @relation("ContractCloneSource", fields: [sourceContractId], references: [id], onDelete: Cascade)
  targetContract         CompanyContract @relation("ContractCloneTarget", fields: [targetContractId], references: [id], onDelete: Cascade)

  @@index([sourceContractId])
  @@index([targetContractId])
  @@index([professorId], map: "ContractDataCloneLog_educatorId_idx")
}

model Aluno {
  id                                                String                                 @id(map: "Athlete_pkey") @default(cuid())
  userId                                            String?
  professorId                                       String?
  age                                               Int?
  weight                                            Float?
  height                                            Float?
  bodyFatPercentage                                 Float?
  vo2Max                                            Float?
  anaerobicThreshold                                Float?
  maxHeartRate                                      Int?
  restingHeartRate                                  Int?
  createdAt                                         DateTime                               @default(now())
  updatedAt                                         DateTime                               @updatedAt
  lastPasswordResetAt                               DateTime?
  schedulePlan                                      AlunoSchedulePlan                      @default(free)
  systolicPressure                                  Int?
  diastolicPressure                                 Int?
  serviceId                                         String?
  currentStudentContractId                          String?
  contractId                                        String
  status                                            StudentLifecycleStatus                 @default(LEAD)
  leadName                                          String?
  leadPhone                                         String?
  leadPhoneNormalized                               String?
  leadEmail                                         String?
  leadEmailNormalized                               String?
  leadCpf                                           String?
  leadCpfNormalized                                 String?
  birthDate                                         DateTime?
  leadOrigin                                        String?
  createdByProfessorId                              String?
  invitedAt                                         DateTime?
  readyForEnrollmentAt                              DateTime?
  activatedAt                                       DateTime?
  discardedAt                                       DateTime?
  discardReason                                     String?
  discardedByProfessorId                            String?
  lastActivityAt                                    DateTime                               @default(now())
  leadAdditionalPhone                               String?
  leadAdditionalPhoneNormalized                     String?
  leadAdditionalEmail                               String?
  leadAdditionalEmailNormalized                     String?
  currentPreRegistrationInviteStatus                PreRegistrationInviteStatus?
  currentPreRegistrationInviteExpiresAt             DateTime?
  parqRequiresProfessionalReview                    Boolean                                @default(false)
  canonicalAlunoId                                  String?
  AdipometryAssessment                              AdipometryAssessment[]
  AdipometrySequence                                AdipometrySequence?
  agendaBookings                                    AgendaBooking[]
  canonicalAluno                                     Aluno?                                 @relation("AlunoToAluno", fields: [canonicalAlunoId], references: [id])
  duplicateAlunos                                    Aluno[]                                @relation("AlunoToAluno")
  contract                                           CompanyContract                        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  createdByProfessor                                 Professor?                             @relation("Aluno_createdByProfessorIdToProfessor", fields: [createdByProfessorId], references: [id])
  currentStudentContract                            StudentContract?                       @relation("AlunoCurrentStudentContract", fields: [currentStudentContractId], references: [id])
  discardedByProfessor                               Professor?                             @relation("Aluno_discardedByProfessorIdToProfessor", fields: [discardedByProfessorId], references: [id])
  service                                           ServiceOption?                         @relation(fields: [serviceId], references: [id])
  professor                                         Professor?                             @relation(fields: [professorId], references: [id], onDelete: Cascade, map: "Athlete_educatorId_fkey")
  user                                              User?                                  @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Athlete_userId_fkey")
  assessmentPlanItems                               AlunoAssessmentPlanItem[]
  exerciseProgress                                  AlunoExerciseProgress[]
  intakeForm                                        AlunoIntakeForm?
  profileReviewSettings                             AlunoProfileReviewSettings?
  anthropometryAssessments                          AnthropometryAssessment[]
  assessments                                       Assessment[]
  CapacityPlanningCycle                             CapacityPlanningCycle[]
  CapacityPrescription                              CapacityPrescription[]
  CapacityPrescriptionVersion                       CapacityPrescriptionVersion[]
  ConsolidatedPrescription                          ConsolidatedPrescription[]
  ConsolidatedPrescriptionVersion                   ConsolidatedPrescriptionVersion[]
  fixedSlots                                        FixedScheduleSlot[]
  contracts                                         Contract[]
  integrations                                      Integration[]
  macronutrients                                    Macronutrients?
  nutritionPlans                                    NutritionPlan[]
  guardianAuthorizations                            PreRegistrationGuardianAuthorization[]
  preRegistrationInvites                            PreRegistrationInvite[]
  progressMetrics                                   ProgressMetric[]
  prontuarioDiscomfortSnapshots                     ProntuarioDiscomfortSnapshot[]
  ProntuarioGoalCapacityClassification              ProntuarioGoalCapacityClassification[]
  prontuarioRecords                                 ProntuarioRecord[]
  studentAssessmentRecords                          StudentAssessmentRecord[]
  studentContracts                                  StudentContract[]                      @relation("AlunoStudentContracts")
  studentExternalAccounts                           StudentExternalAccount[]
  studentExternalActivities                         StudentExternalActivity[]
  studentFinancialProfile                           StudentFinancialProfile?
  studentHealthIntake                               StudentHealthIntake?
  StudentLifecycleEvent                             StudentLifecycleEvent[]
  onboarding                                         StudentOnboardingProcess?
  parqDraft                                         StudentParqDraft?
  parqLegacyRecords                                 StudentParqLegacyRecord[]
  parqProfessionalReviews                           StudentParqProfessionalReview[]
  parqSubmissions                                   StudentParqSubmission[]
  studentProfile                                    StudentProfile?
  profileAuditLogs                                  StudentProfileAuditLog[]
  profileReviews                                    StudentProfileReview[]
  executions                                        TrainingExecution[]
  trainingPlans                                     TrainingPlan[]
  workoutExecutions                                 WorkoutExecution[]

  @@unique([contractId, leadCpfNormalized])
  @@unique([contractId, userId])
  @@unique([id, contractId])
  @@index([serviceId])
  @@index([currentStudentContractId])
  @@index([professorId], map: "Athlete_educatorId_idx")
  @@index([contractId, canonicalAlunoId])
  @@index([contractId, currentPreRegistrationInviteStatus])
  @@index([contractId, lastActivityAt])
  @@index([contractId, leadAdditionalEmailNormalized])
  @@index([contractId, leadAdditionalPhoneNormalized])
  @@index([contractId, leadEmailNormalized])
  @@index([contractId, leadPhoneNormalized])
  @@index([contractId, parqRequiresProfessionalReview])
  @@index([contractId, status])
  @@index([createdByProfessorId])
  @@index([discardedByProfessorId])
}

model StudentContract {
  id                 String                @id @default(cuid())
  alunoId            String
  contractId         String                @unique
  serviceId          String?
  status             StudentContractStatus @default(draft)
  startDate          DateTime?
  endDate            DateTime?
  signedAt           DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  amount             Decimal?
  paymentDay         Int?
  notes              String?
