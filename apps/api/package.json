{
  "name": "@corrida/api",
  "version": "0.1.0",
  "description": "Backend API do sistema de gestão de treinos",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "pnpm --filter @corrida/types build && pnpm --filter @corrida/utils build && pnpm db:generate && tsc",
    "start": "node scripts/migrate-and-start.mjs",
    "test": "jest --runInBand --testPathIgnorePatterns=\"tests/issue-275-authorization-matrix-extended.integration.test.ts|src/modules/pre-registration-invites/pre-registration-invite-concurrency.integration.test.ts|src/modules/pre-registration-invites/pre-registration-invite-temporal-consistency.integration.test.ts\" && jest --runInBand src/modules/pre-registration-invites/pre-registration-invite-concurrency.integration.test.ts && jest --runInBand src/modules/pre-registration-invites/pre-registration-invite-temporal-consistency.integration.test.ts",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-capacity-prescriptions": "tsx src/scripts/seed-capacity-prescription-parameters.ts",
    "db:bootstrap-services-catalog": "tsx src/scripts/bootstrap-services-commercial-catalog.ts",
    "db:clone-contract-data": "tsx src/scripts/clone-contract-data.ts",
    "job:backfill-student-contract-links": "tsx src/scripts/backfill-student-contract-links.ts",
    "job:backfill-student-external-accounts": "tsx src/scripts/backfill-student-external-accounts.ts",
    "job:backfill-student-external-activities": "tsx src/scripts/backfill-student-external-activities.ts",
    "job:dispatch-profile-reviews": "tsx src/scripts/dispatch-profile-reviews.ts",
    "job:backfill-profile-review-settings": "tsx src/scripts/backfill-profile-review-settings.ts",
    "db:studio": "prisma studio",
    "import-exercises": "tsx src/scripts/import-exercises.ts",
    "job:normalize-upload-urls": "tsx src/scripts/normalize-upload-urls.mjs"
  },
  "dependencies": {
    "@corrida/types": "workspace:*",
    "@corrida/utils": "workspace:*",
    "@prisma/client": "^5.7.0",
    "@sendgrid/mail": "^8.1.0",
    "@stripe/stripe-js": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^7.1.0",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.15.0",
    "redis": "^4.6.12",
    "stripe": "^14.10.0",
    "undici": "^6.19.2",
    "twilio": "^4.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "prisma": "^5.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
