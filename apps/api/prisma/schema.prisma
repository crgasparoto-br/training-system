model ProntuarioRecord {
  id                    String                          @id @default(cuid())
  alunoId               String
  contractId            String
  professorId           String?
  code                  String
  status                ProntuarioRecordStatus          @default(open)
  recordDate            DateTime                        @default(now())
  summary               String?
  notes                 String?
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  closedAt              DateTime?
  aluno                 Aluno                           @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  contract              CompanyContract                 @relation(fields: [contractId], references: [id], onDelete: Cascade)
  professor             Professor?                      @relation(fields: [professorId], references: [id], onDelete: SetNull)
  goals                 ProntuarioGoal[]
  anamnesisFollowUps    ProntuarioAnamnesisFollowUp[]
  activityHistory       ProntuarioActivityHistory[]
  medicationsProcedures ProntuarioMedicationProcedure[]
  painCases             ProntuarioPainCase[]
  discomfortSnapshots   ProntuarioDiscomfortSnapshot[]

  @@unique([contractId, alunoId, code])
  @@index([contractId, alunoId, recordDate])
  @@index([professorId])
  @@index([status])
}

model ProntuarioGoal {
  id          String               @id @default(cuid())
  recordId    String
  title       String
  description String?
  status      ProntuarioItemStatus @default(active)
  priority    Int                  @default(0)
  targetDate  DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  record      ProntuarioRecord     @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, status])
  @@index([targetDate])
}

model ProntuarioAnamnesisFollowUp {
  id               String                 @id @default(cuid())
  recordId         String
  parqSubmissionId String?
  itemKey          String
  itemLabel        String
  status           ProntuarioItemStatus   @default(active)
  followUpNotes    String?
  actionPlan       String?
  closedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  record           ProntuarioRecord       @relation(fields: [recordId], references: [id], onDelete: Cascade)
  parqSubmission   StudentParqSubmission? @relation(fields: [parqSubmissionId], references: [id], onDelete: SetNull)

  @@index([recordId, status])
  @@index([parqSubmissionId])
  @@index([itemKey])
}

model ProntuarioActivityHistory {
