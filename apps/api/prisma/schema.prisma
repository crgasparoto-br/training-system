generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  type                    UserType
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  isActive                Boolean                  @default(true)
  lastLoginAt             DateTime?
  aluno                   Aluno?
  notifications           Notification[]
  notificationPreferences NotificationPreferences?
  profileReviewsRequested StudentProfileReview[]   @relation("StudentProfileReviewRequestedBy")
  profileReviewsApproved  StudentProfileReview[]   @relation("StudentProfileReviewApprovedBy")
  profileReviewsRejected  StudentProfileReview[]   @relation("StudentProfileReviewRejectedBy")
  professor               Professor?
  profile                 Profile?

  @@index([email])
}

model Profile {
  id                                   String         @id @default(cuid())
  userId                               String         @unique
  name                                 String
  avatar                               String?
  phone                                String?
  createdAt                            DateTime       @default(now())
  updatedAt                            DateTime       @updatedAt
  birthDate                            DateTime?
  gender                               Gender?
  cpf                                  String?        @unique
  rg                                   String?
  maritalStatus                        MaritalStatus?
  addressStreet                        String?
  addressNumber                        String?
  addressComplement                    String?
  addressZipCode                       String?
  instagramHandle                      String?
  cref                                 String?
  professionalSummary                  String?
  lattesUrl                            String?
  companyDocument                      String?
  bankCode                             String?
  bankName                             String?
  bankBranch                           String?
  bankAccount                          String?
  pixKey                               String?
  legalFinancialProvidedAt             DateTime?
  legalFinancialProvidedByProfessorId  String?
  legalFinancialValidatedAt            DateTime?
  legalFinancialValidatedByProfessorId String?
  addressNeighborhood                  String?
  addressCity                          String?
  addressState                         String?
  legalFinancialProvidedByProfessor    Professor?     @relation("ProfileLegalFinancialProvidedBy", fields: [legalFinancialProvidedByProfessorId], references: [id])
  legalFinancialValidatedByProfessor   Professor?     @relation("ProfileLegalFinancialValidatedBy", fields: [legalFinancialValidatedByProfessorId], references: [id])
  user                                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([legalFinancialProvidedByProfessorId])
  @@index([legalFinancialValidatedByProfessorId])
  @@index([bankCode])
}

model Bank {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  ispb        String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([description])
}

model CompanyContract {
  id                            String                         @id(map: "Contract_pkey") @default(cuid())
  type                          ContractType
  document                      String                         @unique
  name                          String?
  tradeName                     String?
  cref                          String?
  addressStreet                 String?
  addressNumber                 String?
  addressNeighborhood           String?
  addressCity                   String?
  addressState                  String?
  addressComplement             String?
  addressZipCode                String?
  logoUrl                       String?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  agendaBookings                AgendaBooking[]
  anthropometryAssessments      AnthropometryAssessment[]
  anthropometrySegments         AnthropometrySegment[]
  assessmentTypes               AssessmentType[]
  collaboratorFunctions         CollaboratorFunctionOption[]
  cloneLogsAsSource             ContractDataCloneLog[]         @relation("ContractCloneSource")
  cloneLogsAsTarget             ContractDataCloneLog[]         @relation("ContractCloneTarget")
  exerciseLibrary               ExerciseLibrary[]
  hourlyRateLevels              HourlyRateLevel[]
  professores                   Professor[]
  professorManualItems          ProfessorManualItem[]
  services                      ServiceOption[]
  serviceCommercialOptions      ServiceCommercialOption[]
  servicePresentationItems      ServicePresentationItem[]
  servicePlanComponents         ServicePlanComponent[]
  subjectiveScaleItems          SubjectiveScaleItem[]
  trainingParameters            TrainingParameter[]
  trainingSpaces                TrainingSpace[]
  contractTemplates             ContractTemplate[]
  generatedContracts            Contract[]
  studentProfiles               StudentProfile[]
  studentHealthIntakes          StudentHealthIntake[]
  studentAssessmentRecords      StudentAssessmentRecord[]
  studentFinancialProfiles      StudentFinancialProfile[]
  studentExternalAccounts       StudentExternalAccount[]
  studentExternalActivities     StudentExternalActivity[]
  profileReviewPolicies         ProfileReviewPolicy[]
  studentParqSubmissions        StudentParqSubmission[]
  prontuarioRecords             ProntuarioRecord[]
  prontuarioDiscomfortSnapshots ProntuarioDiscomfortSnapshot[]

  @@index([type])
  @@map("Contract")
}

model ContractTemplate {
  id          String                   @id @default(cuid())
  contractId  String
  name        String
  description String?
  serviceId   String?
  version     Int                      @default(1)
  status      ContractTemplateStatus   @default(DRAFT)
  applicability ContractTemplateApplicability @default(STUDENT)
  headerHtml  String                   @default("")
  footerHtml  String                   @default("")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  contract    CompanyContract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service     ServiceOption?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  clauses     ContractTemplateClause[]
  contracts   Contract[]

  @@index([contractId, status])
  @@index([serviceId])
}

model ContractTemplateClause {
  id         String           @id @default(cuid())
  templateId String
  order      Int
  title      String
  bodyHtml   String
  required   Boolean          @default(true)
  editable   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  template   ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, order])
  @@index([templateId])
}

model Contract {
  id                   String              @id(map: "GeneratedContract_pkey") @default(cuid())
  companyContractId    String
  templateId           String
  templateVersion      Int
  alunoId              String?
  collaboratorId       String?
  partyType            ContractPartyType @default(STUDENT)
  origin               ContractLinkOrigin @default(ELECTRONIC)
  responsavelName      String?
  responsavelCpf       String?
  responsavelEmail     String?
  serviceId            String?
  professorId          String?
  status               ContractStatus      @default(DRAFT)
  title                String
  renderedHtml         String
  dataSnapshot         Json
  pdfPath              String?
  publicTokenHash      String?             @unique
  publicTokenExpiresAt DateTime?
  externalProvider     String?
  externalEnvelopeId   String?
  documentHash         String?
  signedAt             DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  companyContract      CompanyContract     @relation(fields: [companyContractId], references: [id], onDelete: Cascade)
  template             ContractTemplate    @relation(fields: [templateId], references: [id])
  aluno                Aluno?              @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  collaborator         Professor?          @relation("ContractCollaborator", fields: [collaboratorId], references: [id], onDelete: Restrict)
  service              ServiceOption?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professor            Professor?          @relation("ContractResponsibleProfessor", fields: [professorId], references: [id], onDelete: SetNull)
  signatures           ContractSignature[]
  auditLogs            ContractAuditLog[]
  studentContracts     StudentContract[]
  collaboratorContract CollaboratorContract?

  @@index([companyContractId, status])
  @@index([alunoId])
  @@index([collaboratorId])
  @@index([partyType])
  @@index([templateId])
  @@index([serviceId])
  @@index([professorId])
  @@map("GeneratedContract")
}

model CollaboratorContract {
  id                 String                     @id @default(cuid())
  collaboratorId     String
  contractId         String?                    @unique
  status             CollaboratorContractStatus @default(draft)
  origin             ContractLinkOrigin         @default(ELECTRONIC)
  startDate          DateTime?
  endDate            DateTime?
  signedAt           DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  notes              String?
  legacyDocumentUrl  String?
  legacySourceKey    String?                    @unique
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  collaborator        Professor  @relation("CollaboratorContracts", fields: [collaboratorId], references: [id], onDelete: Restrict)
  contract            Contract?  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  currentForProfessor Professor? @relation("CurrentCollaboratorContract")

  @@index([collaboratorId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model ContractSignature {
  id           String   @id @default(cuid())
  contractId   String
  signerName   String
  signerCpf    String
  signerEmail  String?
  ipAddress    String?
  userAgent    String?
  acceptedAt   DateTime @default(now())
  documentHash String
  method       String   @default("INTERNAL_ELECTRONIC_ACCEPTANCE")
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([signerCpf])
}

model ContractAuditLog {
  id          String              @id @default(cuid())
  contractId  String
  actorUserId String?
  action      ContractAuditAction
  details     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime            @default(now())
  contract    Contract            @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, createdAt])
  @@index([actorUserId])
}

model CollaboratorFunctionOption {
  id                String             @id @default(cuid())
  contractId        String
  name              String
  code              String
  isActive          Boolean            @default(true)
  isSystem          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now()) @updatedAt
  accessPermissions AccessPermission[]
  contract          CompanyContract    @relation(fields: [contractId], references: [id], onDelete: Cascade)
  professores       Professor[]

  @@unique([contractId, code])
  @@index([contractId])
}

model AccessPermission {
  id                     String                     @id @default(cuid())
  collaboratorFunctionId String
  screenKey              String
  blockKey               String                     @default("")
  canView                Boolean                    @default(true)
  dataScope              String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @default(now()) @updatedAt
  collaboratorFunction   CollaboratorFunctionOption @relation(fields: [collaboratorFunctionId], references: [id], onDelete: Cascade)

  @@unique([collaboratorFunctionId, screenKey, blockKey])
  @@index([collaboratorFunctionId])
  @@index([screenKey])
}

model Professor {
  id                              String                     @id(map: "Educator_pkey") @default(cuid())
  userId                          String                     @unique(map: "Educator_userId_key")
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  contractId                      String
  role                            ProfessorRole              @default(professor)
  collaboratorFunctionId          String
  responsibleManagerId            String?
  admissionDate                   DateTime?
  currentStatus                   String?
  currentCollaboratorContractId   String?                    @unique
  operationalRoleIds              String[]                   @default([])
  hourlyRates                     Json?
  hasSignedContract               Boolean                    @default(false)
  signedContractDocumentUrl       String?
  dismissalDate                   DateTime?
  agendaBookings                  AgendaBooking[]
  alunos                          Aluno[]
  anthropometryAssessments        AnthropometryAssessment[]
  prontuarioRecords               ProntuarioRecord[]
  assessmentAuditLogs             AssessmentAuditLog[]
  cloneLogs                       ContractDataCloneLog[]
  generatedContracts              Contract[]                  @relation("ContractResponsibleProfessor")
  generatedCollaboratorContracts  Contract[]                  @relation("ContractCollaborator")
  collaboratorContracts           CollaboratorContract[]      @relation("CollaboratorContracts")
  currentCollaboratorContract     CollaboratorContract?       @relation("CurrentCollaboratorContract", fields: [currentCollaboratorContractId], references: [id], onDelete: SetNull)
  fixedSlots                      FixedScheduleSlot[]
  contract                        CompanyContract            @relation(fields: [contractId], references: [id], onDelete: Cascade, map: "Educator_contractId_fkey")
  user                            User                       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Educator_userId_fkey")
  collaboratorFunction            CollaboratorFunctionOption @relation(fields: [collaboratorFunctionId], references: [id])
  responsibleManager              Professor?                 @relation("ProfessorResponsibleManager", fields: [responsibleManagerId], references: [id])
  managedCollaborators            Professor[]                @relation("ProfessorResponsibleManager")
  availabilities                  ProfessorAvailability[]
  providedLegalFinancialProfiles  Profile[]                  @relation("ProfileLegalFinancialProvidedBy")
  validatedLegalFinancialProfiles Profile[]                  @relation("ProfileLegalFinancialValidatedBy")
  subscription                    Subscription?
  library                         TrainingLibrary[]
  plans                           TrainingPlan[]
  Assessment                      Assessment[]

  @@index([collaboratorFunctionId])
  @@index([responsibleManagerId])
  @@index([currentCollaboratorContractId])
  @@index([contractId], map: "Educator_contractId_idx")
}

model ContractDataCloneLog {
  id                     String          @id @default(cuid())
  sourceContractId       String
  targetContractId       String
  professorId            String?
  parametersCreated      Int
  parametersSkipped      Int
  exercisesCreated       Int
  exercisesSkipped       Int
  createdAt              DateTime        @default(now())
  assessmentTypesCreated Int             @default(0)
  assessmentTypesSkipped Int             @default(0)
  professor              Professor?      @relation(fields: [professorId], references: [id], map: "ContractDataCloneLog_educatorId_fkey")
  sourceContract         CompanyContract @relation("ContractCloneSource", fields: [sourceContractId], references: [id], onDelete: Cascade)
  targetContract         CompanyContract @relation("ContractCloneTarget", fields: [targetContractId], references: [id], onDelete: Cascade)

  @@index([sourceContractId])
  @@index([targetContractId])
  @@index([professorId], map: "ContractDataCloneLog_educatorId_idx")
}

model Aluno {
  id                            String                         @id(map: "Athlete_pkey") @default(cuid())
  userId                        String                         @unique(map: "Athlete_userId_key")
  professorId                   String
  age                           Int
  weight                        Float?
  height                        Float?
  bodyFatPercentage             Float?
  vo2Max                        Float?
  anaerobicThreshold            Float?
  maxHeartRate                  Int?
  restingHeartRate              Int?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  lastPasswordResetAt           DateTime?
  schedulePlan                  AlunoSchedulePlan              @default(free)
  systolicPressure              Int?
  diastolicPressure             Int?
  serviceId                     String?
  currentStudentContractId      String?
  agendaBookings                AgendaBooking[]
  anthropometryAssessments      AnthropometryAssessment[]
  service                       ServiceOption?                 @relation(fields: [serviceId], references: [id])
  currentStudentContract        StudentContract?               @relation("AlunoCurrentStudentContract", fields: [currentStudentContractId], references: [id], onDelete: SetNull)
  professor                     Professor                      @relation(fields: [professorId], references: [id], onDelete: Cascade, map: "Athlete_educatorId_fkey")
  user                          User                           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Athlete_userId_fkey")
  exerciseProgress              AlunoExerciseProgress[]
  intakeForm                    AlunoIntakeForm?
  profileReviewSettings         AlunoProfileReviewSettings?
  profileReviews                StudentProfileReview[]
  assessmentPlanItems           AlunoAssessmentPlanItem[]
  assessments                   Assessment[]
  contracts                     Contract[]
  studentContracts              StudentContract[]              @relation("AlunoStudentContracts")
  fixedSlots                    FixedScheduleSlot[]
  integrations                  Integration[]
  macronutrients                Macronutrients?
  nutritionPlans                NutritionPlan[]
  profileAuditLogs              StudentProfileAuditLog[]
  progressMetrics               ProgressMetric[]
  executions                    TrainingExecution[]
  trainingPlans                 TrainingPlan[]
  workoutExecutions             WorkoutExecution[]
  studentProfile                StudentProfile?
  studentHealthIntake           StudentHealthIntake?
  studentAssessmentRecords      StudentAssessmentRecord[]
  studentFinancialProfile       StudentFinancialProfile?
  studentExternalAccounts       StudentExternalAccount[]
  studentExternalActivities     StudentExternalActivity[]
  parqSubmissions               StudentParqSubmission[]
  prontuarioRecords             ProntuarioRecord[]
  prontuarioDiscomfortSnapshots ProntuarioDiscomfortSnapshot[]

  @@index([serviceId])
  @@index([currentStudentContractId])
  @@index([professorId], map: "Athlete_educatorId_idx")
}

model StudentContract {
  id                 String                @id @default(cuid())
  alunoId            String
  contractId         String                @unique
  serviceId          String?
  status             StudentContractStatus @default(draft)
  startDate          DateTime?
  endDate            DateTime?
  signedAt           DateTime?
  canceledAt         DateTime?
  cancellationReason String?
  amount             Decimal?
  paymentDay         Int?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  aluno              Aluno                 @relation("AlunoStudentContracts", fields: [alunoId], references: [id], onDelete: Cascade)
  contract           Contract              @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service            ServiceOption?        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  currentForAlunos   Aluno[]               @relation("AlunoCurrentStudentContract")

  @@index([alunoId])
  @@index([contractId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model ProfileReviewPolicy {
  id                        String          @id @default(cuid())
  contractId                String
  defaultReviewPeriodMonths Int             @default(4)
  isActive                  Boolean         @default(true)
  sections                  Json
  reminderBeforeDays        Int?
  reminderAfterDays         Int?
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
  contract                  CompanyContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, isActive])
}

model AlunoProfileReviewSettings {
  id                 String    @id @default(cuid())
  alunoId            String    @unique
  reviewPeriodMonths Int?
  nextReviewAt       DateTime?
  isReviewRequired   Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  aluno              Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([nextReviewAt])
  @@index([isReviewRequired])
}

model StudentProfileReview {
  id                String                     @id @default(cuid())
  alunoId           String
  requestedByUserId String?
  requestedAt       DateTime                   @default(now())
  dueAt             DateTime?
  completedAt       DateTime?
  status            StudentProfileReviewStatus @default(pending)
  sectionsRequested Json?
  snapshotBefore    Json?
  snapshotAfter     Json?
  changedFields     Json?
  requiresApproval  Boolean                    @default(false)
  approvedByUserId  String?
  approvedAt        DateTime?
  rejectedByUserId  String?
  rejectedAt        DateTime?
  rejectionReason   String?
  nextReviewAt      DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  aluno             Aluno                      @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  requestedByUser   User?                      @relation("StudentProfileReviewRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  approvedByUser    User?                      @relation("StudentProfileReviewApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedByUser    User?                      @relation("StudentProfileReviewRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@index([alunoId, status])
  @@index([requestedAt])
  @@index([dueAt])
  @@index([nextReviewAt])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
}

model ServiceOption {
  id                       String                    @id @default(cuid())
  contractId               String
  name                     String
  code                     String
  description              String?
  parentServiceId          String?
  monthlyPrice             Float?
  validFrom                DateTime?
  validUntil               DateTime?
  isActive                 Boolean                   @default(true)
  isSystem                 Boolean                   @default(false)
  category                 String                    @default("individual_service")
  summary                  String?
  whatIs                   String?
  targetAudience           String?
  displayOrder             Int                       @default(0)
  origin                   String                    @default("legacy")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @default(now()) @updatedAt
  alunos                   Aluno[]
  studentContracts         StudentContract[]
  contractTemplates        ContractTemplate[]
  generatedContracts       Contract[]
  contract                 CompanyContract           @relation(fields: [contractId], references: [id], onDelete: Cascade)
  parentService            ServiceOption?            @relation("ServiceOptionOffers", fields: [parentServiceId], references: [id], onDelete: SetNull)
  financialOffers          ServiceOption[]           @relation("ServiceOptionOffers")
  commercialOptions        ServiceCommercialOption[]
  presentationItems        ServicePresentationItem[]
  planComponents           ServicePlanComponent[]    @relation("PlanServiceComponents")
  referencedPlanComponents ServicePlanComponent[]    @relation("TargetServiceComponents")

  @@unique([contractId, code])
  @@index([contractId])
  @@index([parentServiceId])
  @@index([contractId, category, isActive, displayOrder])
}

model ServiceCommercialOption {
  id             String                 @id @default(cuid())
  contractId     String
  serviceId      String
  code           String
  name           String
  frequency      String?
  quantity       Decimal?               @db.Decimal(10, 2)
  unit           String?
  priceType      String
  priceAmount    Decimal?               @db.Decimal(12, 2)
  validFrom      DateTime?
  validUntil     DateTime?
  isActive       Boolean                @default(true)
  displayOrder   Int                    @default(0)
  origin         String                 @default("manual")
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt
  contract       CompanyContract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service        ServiceOption          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  planComponents ServicePlanComponent[] @relation("TargetOptionComponents")

  @@unique([contractId, code])
  @@index([contractId, serviceId, isActive, displayOrder])
  @@index([contractId, validFrom, validUntil])
}

model ServicePresentationItem {
  id           String          @id @default(cuid())
  contractId   String
  serviceId    String
  text         String
  isActive     Boolean         @default(true)
  displayOrder Int             @default(0)
  origin       String          @default("manual")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt
  contract     CompanyContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  service      ServiceOption   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([contractId, serviceId, isActive, displayOrder])
}

model ServicePlanComponent {
  id              String                   @id @default(cuid())
  contractId      String
  planServiceId   String
  targetServiceId String?
  targetOptionId  String?
  quantity        Decimal?                 @db.Decimal(10, 2)
  unit            String?
  notes           String?
  isActive        Boolean                  @default(true)
  displayOrder    Int                      @default(0)
  origin          String                   @default("manual")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @default(now()) @updatedAt
  contract        CompanyContract          @relation(fields: [contractId], references: [id], onDelete: Cascade)
  planService     ServiceOption            @relation("PlanServiceComponents", fields: [planServiceId], references: [id], onDelete: Cascade)
  targetService   ServiceOption?           @relation("TargetServiceComponents", fields: [targetServiceId], references: [id], onDelete: Restrict)
  targetOption    ServiceCommercialOption? @relation("TargetOptionComponents", fields: [targetOptionId], references: [id], onDelete: Restrict)

  @@index([contractId, planServiceId, isActive, displayOrder])
  @@index([contractId, targetServiceId])
  @@index([contractId, targetOptionId])
}

model AlunoIntakeForm {
  id                 String    @id @default(cuid())
  alunoId            String    @unique
  assessmentDate     DateTime?
  mainGoal           String?
  medicalHistory     String?
  currentMedications String?
  injuriesHistory    String?
  trainingBackground String?
  observations       String?
  parqResponses      Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  formResponses      Json?
  aluno              Aluno     @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@index([assessmentDate])
}

model TrainingSpace {
  id         String              @id @default(cuid())
  contractId String
  name       String
  capacity   Int                 @default(1)
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  bookings   AgendaBooking[]
  fixedSlots FixedScheduleSlot[]
  contract   CompanyContract     @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, name])
  @@index([contractId])
}

model ProfessorAvailability {
  id          String    @id(map: "EducatorAvailability_pkey") @default(cuid())
  professorId String
  dayOfWeek   Int
  startTime   String
  endTime     String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  professor   Professor @relation(fields: [professorId], references: [id], onDelete: Cascade, map: "EducatorAvailability_educatorId_fkey")

  @@unique([professorId, dayOfWeek, startTime, endTime], map: "EducatorAvailability_educatorId_dayOfWeek_startTime_endTime_key")
  @@index([professorId, dayOfWeek], map: "EducatorAvailability_educatorId_dayOfWeek_idx")
}

model FixedScheduleSlot {
  id          String          @id @default(cuid())
  alunoId     String
  professorId String
  spaceId     String?
  dayOfWeek   Int
  startTime   String
  endTime     String
  isActive    Boolean         @default(true)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookings    AgendaBooking[]
  aluno       Aluno           @relation(fields: [alunoId], references: [id], onDelete: Cascade, map: "FixedScheduleSlot_athleteId_fkey")
  professor   Professor       @relation(fields: [professorId], references: [id], onDelete: Cascade, map: "FixedScheduleSlot_educatorId_fkey")
  space       TrainingSpace?  @relation(fields: [spaceId], references: [id])

  @@index([spaceId, dayOfWeek, isActive])
