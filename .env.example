# Database
# URL usada pela API em execucao. Em producao, prefira usuario de aplicacao e endpoint com pool.
DATABASE_URL="postgresql://corrida_user:corrida_password_dev@localhost:5432/corrida_db"
# URL direta/privilegiada usada somente por `prisma migrate deploy` durante o start.
# Quando vazia, o start usa DATABASE_URL por compatibilidade.
MIGRATION_DATABASE_URL=""
# Limite por PrismaClient. O runtime aplica 1 em producao quando a URL nao define connection_limit.
PRISMA_CONNECTION_LIMIT="1"
# Tempo maximo, em segundos, para aguardar uma conexao livre no pool.
PRISMA_POOL_TIMEOUT_SECONDS="15"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Convites, pré-cadastro público e rollout (issues #269, #271 e #275)
# Em produção, a API fica desabilitada quando PRE_REGISTRATION_ENABLED está
# ausente ou inválida. Habilite somente depois de migrations e API estarem prontas.
PRE_REGISTRATION_ENABLED="true"
# Emite somente métricas HTTP técnicas agregadas, sem caminho, token, payload,
# usuário, tenant ou dados pessoais. Pode ser desabilitada independentemente.
PRE_REGISTRATION_TELEMETRY_ENABLED="true"
# Validade padrão, em dias, do convite público de pré-cadastro. Configurável;
# usa 30 quando ausente ou inválido.
PRE_REGISTRATION_INVITE_TTL_DAYS="30"
# Documento vigente apresentado e registrado no consentimento do pré-cadastro.
PRIVACY_NOTICE_URL="http://localhost:5173/privacidade"
PRIVACY_NOTICE_VERSION="2026-07"

# API
API_PORT=3000
API_HOST="localhost"
NODE_ENV="development"
CORS_ORIGINS="http://localhost:5173,http://localhost:8081,exp://localhost:8081"
# Contrato de origem preferencial para o fluxo "Clonar dados" da tela de contrato.
# Ele só tem precedência quando for diferente do contrato autenticado e possuir ao
# menos um parâmetro de treinamento, exercício de biblioteca ou tipo de avaliação;
# caso contrário, a API seleciona automaticamente outra origem elegível.
DEFAULT_CONTRACT_ID=""
# Caminho absoluto para uploads persistentes (ex.: disco persistente do Render).
# Quando vazio, usa ./uploads relativo ao diretório da API.
UPLOAD_STORAGE_ROOT=""
# Base publica usada para montar URLs de uploads persistidos no banco.
# Em producao, prefira ASSET_BASE_URL apontando para storage/CDN persistente.
ASSET_BASE_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3000"
# Base HTTPS pública da API usada em callbacks de confirmação de entrega.
# Em produção deve apontar para a própria API, sem path final.
NOTIFICATION_CALLBACK_BASE_URL=""
# Provider de storage para assets publicos de logo/avatar: local, supabase ou r2.
ASSET_STORAGE_PROVIDER="local"
# URL raiz do projeto Supabase, sem /rest/v1/.
SUPABASE_URL=""
# Service role key deve existir somente no backend/API. Nunca use no frontend.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="sistema-acesso-assets"
ASSET_PUBLIC_BASE_URL=""
# Cloudflare R2 para assets publicos de logo/avatar quando ASSET_STORAGE_PROVIDER="r2".
R2_ACCOUNT_ID=""
R2_BUCKET="sistema-acesso-assets"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL=""

# Frontend
VITE_API_URL="http://localhost:3000"
REACT_APP_API_URL="http://localhost:3000"
# O build de produção fica fail-safe quando esta flag está ausente ou inválida.
# Mantenha alinhada com PRE_REGISTRATION_ENABLED na API.
VITE_PRE_REGISTRATION_ENABLED="true"

# Mobile
EXPO_API_URL="http://localhost:3000"

# Email (SendGrid)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@corrida.local"
# Public key do Signed Event Webhook do SendGrid. Não é segredo.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=""

# Recuperação de senha
PASSWORD_RESET_SECRET=""
PASSWORD_RESET_EXPIRES_IN="1h"

# SMS/WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""
# Content SID (HX...) de template Utility aprovado no WhatsApp para a revisão cadastral.
# O template deve conter apenas a mensagem mínima segura; o backend não envia Body livre.
TWILIO_WHATSAPP_PROFILE_REVIEW_CONTENT_SID=""

# Payments (Stripe)
STRIPE_SECRET_KEY=""
STRIPE_PUBLIC_KEY=""
STRIPE_WEBHOOK_SECRET=""

# External APIs
GARMIN_CLIENT_ID=""
GARMIN_CLIENT_SECRET=""
STRAVA_CLIENT_ID=""
STRAVA_CLIENT_SECRET=""
DIETA_IA_WHATSAPP_NUMBER=""
JIRA_BASE_URL=""
JIRA_USER_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY="SDT"

# Monitoring
SENTRY_DSN=""

# Frontend URLs
FRONTEND_URL="http://localhost:5173"
MOBILE_URL="exp://localhost:8081"

